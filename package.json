{
  "name": "lumi-games",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build:ios": "rimraf app.ipa && eas build --platform ios --local --non-interactive --output app.ipa",
    "build:android": "rimraf app.aab && eas build --platform android --local  --non-interactive --output app.aab",
    "build": "yarn build:ios && yarn build:android",
    "submit:ios": "eas submit -p ios --path app.ipa",
    "submit:android": "eas submit -p android --path app.aab",
    "submit": "yarn submit:ios && yarn submit:android",
    "ota": "eas update --branch production --auto"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "~1.17.3",
    "expo": "~48.0.4",
    "expo-dev-client": "^2.1.4",
    "expo-linking": "^4.0.1",
    "expo-splash-screen": "~0.18.1",
    "expo-status-bar": "1.4.4",
    "expo-updates": "0.16.3",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.71.3",
    "react-native-web": "0.18.12",
    "react-native-webview": "11.26.0"
  },
  "devDependencies": {
    "@babel/core": "7.19.6",
    "eas-cli": "3.7.2",
    "prettier": "2.7.1",
    "rimraf": "3.0.2" 
  },
  "private": true
}
