{
  "name": "lumi-games",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:ios": "rimraf app.ipa && eas build --platform ios --local --non-interactive --output app.ipa",
    "upload": "eas submit -p ios --path app.ipa",
    "ota": "eas update -p ios --branch production --auto"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "~1.17.3",
    "expo": "~46.0.17",
    "expo-dev-client": "1.3.1",
    "expo-linking": "~3.2.2",
    "expo-splash-screen": "~0.16.2",
    "expo-status-bar": "1.4.0",
    "expo-updates": "0.14.7",
    "react": "18.0.0",
    "react-dom": "18.0.0",
    "react-native": "0.69.6",
    "react-native-web": "0.18.7",
    "react-native-webview": "11.23.0"
  },
  "devDependencies": {
    "@babel/core": "7.19.6",
    "eas-cli": "2.6.0",
    "prettier": "2.7.1",
    "rimraf": "3.0.2"
  },
  "private": true
}
